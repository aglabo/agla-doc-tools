{
  "name": "@aglabo/project-starter-template",
  "version": "0.3.0",
  "private": true,
  "description": "agla doc tools: A set of tools for documentation development.",
  "keywords": [
    "template",
    "starter",
    "oss",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/agla-doc-tools.git"
  },
  "license": "MIT",
  "author": "atsushifx",
  "type": "module",
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "scan:secrets": "concurrently \"betterleaks protect --config ./configs/betterleaks.toml\" \"secretlint --secretlintrc ./configs/secretlint.config.yaml .\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "lint:gha": "concurrently \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "bash runners/run-textlint.sh ",
    "lint:markdown": "bash runners/run-markdownlint.sh "
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@proofdict/textlint-rule-proofdict": "^3.1.2",
    "@textlint-ja/textlint-rule-morpheme-match": "^2.0.0",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "cspell": "^10.4.0",
    "markdown-it": "^14.3.1",
    "markdownlint-cli2": "^0.22.1",
    "remark-cli": "^12.0.1",
    "remark-lint": "^10.0.1",
    "remark-mdx": "^3.1.1",
    "sudachi-synonyms-dictionary": "^18.0.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-allowlist": "^4.0.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-ja-no-orthographic-variants": "^2.0.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-preset-ja-spacing": "^3.0.4",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "@(#)": "agla doc tools: A set of tools for documentation development."
}
